# ==============================================================================
# Kalshi Prediction Market Arbitrage Engine - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and modify settings as needed:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Kalshi API Endpoints
# ------------------------------------------------------------------------------
# Base REST API URL (defaults to Kalshi elections public v2 endpoint)
KALSHI_API_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_REQUEST_TIMEOUT_SEC=10.0

# Optional: Kalshi Authenticated API credentials (for private trading/execution)
# Public market data & order books do NOT require credentials.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# ------------------------------------------------------------------------------
# 2. Execution Realism & Latency Simulator Defaults
# ------------------------------------------------------------------------------
# One-way network wire + order book matching delay (milliseconds)
DEFAULT_LATENCY_MS=25.0

# Empirical arbitrage opportunity half-life (milliseconds)
DEFAULT_HALF_LIFE_MS=45.0

# Fill factor haircut for competing order flow at front-of-queue (0.0 to 1.0)
DEFAULT_QUEUE_HAIRCUT=0.75

# Exchange taker fee per contract in dollars (e.g., $0.005 on Kalshi)
DEFAULT_TAKER_FEE=0.005

# Minimum required annualized return on capital (AROC) hurdle rate (e.g. 0.15 for 15%)
DEFAULT_ANNUAL_HURDLE_RATE=0.15

# Default capital cap per trade / budget limit in dollars
DEFAULT_CAPITAL_CAP=1000.0

# ------------------------------------------------------------------------------
# 3. Data & Replay Engine
# ------------------------------------------------------------------------------
REPLAY_DATASET_PATH=data/kalshi_replay_sp500.jsonl
LOG_LEVEL=INFO
